# CourseMap AI Backend — environment variables (EXAMPLE ONLY)
# 复制为 .env（本地）或在部署平台配置为 Secret。
# 硬约束：真实 Key 绝不写入 Git 仓库 / 前端 / 文档 / 日志。

DEEPSEEK_API_KEY=

# 模型名（可选）。默认跟随 DeepSeek 官方当前模型表。
# 官方模型表核验于 2026-10-06：deepseek-v4-flash / deepseek-v4-pro / deepseek-v4-flash-vision-exp（实验）。
# ⚠️ deepseek-chat、deepseek-reasoner 已于 2026-07-24 15:59 UTC 永久停用，调用会返回 HTTP 错误，不要使用。
DEEPSEEK_MODEL=deepseek-v4-flash

# API base URL（可选）。官方 OpenAI 兼容入口。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 思考模式（可选）。官方默认「开启」（effort=high）。
# CourseMap 的 Stage A/B 需要低延迟 + 可复现，因此默认显式关闭。
# 若设为 enabled，适配器会自动按官方要求回传 reasoning_content（否则工具调用会 400）。
DEEPSEEK_THINKING=disabled

# 思考强度（可选，仅在 DEEPSEEK_THINKING=enabled 时生效）：low | high | max
DEEPSEEK_REASONING_EFFORT=low

# 单次请求输出上限（token，可选）
DEEPSEEK_MAX_OUTPUT_TOKENS=2400

# 请求超时（毫秒，可选）
DEEPSEEK_TIMEOUT_MS=45000

# CORS 允许的 Origin（逗号分隔，可选）
ALLOWED_ORIGIN=https://gina0014.github.io,http://127.0.0.1:8799,http://localhost:8799
